# Copy to .env before: docker compose -f docker-compose.prod.yml up --build
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"

DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-50-plus-random-characters-not-the-dev-key
POSTGRES_PASSWORD=replace-with-strong-db-password
ALLOWED_HOSTS=api.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-shop.example.com
CSRF_TRUSTED_ORIGINS=https://your-shop.example.com,https://api.your-domain.com

# Set True only when HTTPS terminates in front (Caddy, nginx, Render, Railway)
SECURE_SSL_REDIRECT=False
SEED_CATALOG=True

ALLOW_MOCK_PAYMENTS=False
DEFAULT_PAYMENT_GATEWAY=chapa
DEFAULT_CURRENCY=ETB

CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYMENT_SUCCESS_URL=https://your-shop.example.com/checkout/success
PAYMENT_CANCEL_URL=https://your-shop.example.com/checkout/cancel

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=orders@your-domain.com
LOG_LEVEL=INFO
